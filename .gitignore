# ==========================================
# Git Ignore for AI for Controls
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.coverage
htmlcov/
*.coverage.*

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Node / Frontend ---
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.local/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Environment & Secret Keys ---
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local

# --- Databases & SQLite ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqbpro
backend/*.db
backend/*.db-wal
backend/*.db-shm

# --- Uploaded Documents & Cache ---
backend/uploads/*
!backend/uploads/.gitkeep
test-output/

# --- Logs ---
*.log
logs/

# --- IDE & Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- OS Specific ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
